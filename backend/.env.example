# ToplineShop — Backend Environment Variables
# This file is safe to commit. Contains placeholder values only.
# NEVER commit a .env file with real credentials.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="4000"

# ── API ───────────────────────────────────────────────────────────────────────
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Comma-separated list of allowed CORS origins.
# Production: set to exact frontend domain(s). Wildcard (*) is rejected in production.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ── Database ──────────────────────────────────────────────────────────────────
# Required. In production: provide via secret manager / CI secret injection.
# Production pooling guidance (append to URL):
#   ?connection_limit=20&pool_timeout=10
#   Safe starting range: connection_limit 10–25; validate under load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be a strong random string (min 32 chars).
# If missing or set to a known placeholder in production → FATAL startup error.
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET="CHANGE_ME_DEV_ONLY"
JWT_REFRESH_SECRET="CHANGE_ME_DEV_ONLY"

# ── Cookie security ───────────────────────────────────────────────────────────
# Set to "true" when using HTTPS on a non-production environment (e.g. staging).
# In NODE_ENV=production this is always forced to true regardless of this value.
COOKIE_SECURE="false"

# ── File storage ──────────────────────────────────────────────────────────────
# Local filesystem root for TDR uploads and exports.
# Development default: process.cwd()/uploads (relative to backend/ dir).
# Recommended local dev: D:\ToplineShopData\TDR
# Production: use IStorageAdapter with S3 (see post-MVP MEGA-8).
TDR_STORAGE_PATH="D:\\ToplineShopData\\TDR"

# ── TLS / HTTPS ───────────────────────────────────────────────────────────────
# Production deployment contract:
#   - HTTPS is MANDATORY in production.
#   - TLS termination must occur at the reverse proxy / load balancer / ingress.
#   - This application serves HTTP; the proxy forwards to it over the internal network.
#   - Secure cookies depend on HTTPS being present at the client-facing layer.
#   - Do NOT trust arbitrary X-Forwarded-* headers unless your proxy is verified.
#
# Deployment example (nginx):
#   listen 443 ssl;
#   proxy_pass http://localhost:4000;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto https;

# ── Secret management contract ────────────────────────────────────────────────
# Secrets must be injected into the environment at deploy time via:
#   - CI/CD secret store (GitHub Actions secrets, GitLab CI variables, etc.)
#   - Cloud secret manager (AWS Secrets Manager, GCP Secret Manager, etc.)
#   - Container orchestrator secrets (Kubernetes secrets, Docker Swarm secrets)
# NEVER commit real secrets to this repository.
# The application validates secrets at startup and refuses to start if invalid.
