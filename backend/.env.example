# ToplineShop — Backend Environment Variables
# This file is safe to commit. Contains placeholder values only.
# NEVER commit a .env file with real credentials.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="4000"

# ── API ───────────────────────────────────────────────────────────────────────
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Comma-separated list of allowed CORS origins.
# Production: set to exact frontend domain(s). Wildcard (*) is rejected in production.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ── Database ──────────────────────────────────────────────────────────────────
# Required. In production: provide via secret manager / CI secret injection.
# Production pooling guidance (append to URL):
#   ?connection_limit=20&pool_timeout=10
#   Safe starting range: connection_limit 10–25; validate under load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be a strong random string (min 32 chars).
# If missing or set to a known placeholder in production → FATAL startup error.
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET="CHANGE_ME_DEV_ONLY"
JWT_REFRESH_SECRET="CHANGE_ME_DEV_ONLY"

# ── Cookie security ───────────────────────────────────────────────────────────
# Set to "true" when using HTTPS on a non-production environment (e.g. staging).
# In NODE_ENV=production this is always forced to true regardless of this value.
COOKIE_SECURE="false"

# ── File storage ──────────────────────────────────────────────────────────────
# STORAGE_ADAPTER: "local" (default dev) or "s3" (production).
STORAGE_ADAPTER="local"

# Local filesystem root — used when STORAGE_ADAPTER=local.
# Development default: {cwd}/uploads
# Recommended local dev: D:\ToplineShopData\TDR
# NOT a production backup — see durability contract below.
TDR_STORAGE_PATH="D:\\ToplineShopData\\TDR"

# S3-compatible object storage — used when STORAGE_ADAPTER=s3.
# Set these via CI/CD secret injection. Never commit real values.
# Compatible with AWS S3, MinIO, Cloudflare R2, or any S3-compatible endpoint.
S3_BUCKET=""
S3_REGION="ap-south-1"
# S3_ENDPOINT is optional — omit for AWS S3, set for non-AWS endpoints (e.g. MinIO).
S3_ENDPOINT=""
# S3_KEY_PREFIX is optional — namespaces objects inside a shared bucket (default: "tdr/").
S3_KEY_PREFIX="tdr/"
# Required when STORAGE_ADAPTER=s3. Inject from secret manager in production.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Storage durability contract ────────────────────────────────────────────────
# LOCAL (D:\ dev): NOT durable production storage. For development only.
#   - No automatic backup. Manual backup required.
#   - D: drive is a development convenience, not a production-grade store.
# PRODUCTION (S3): Use S3-compatible durable object storage.
#   - Versioning recommended.
#   - Encryption at rest recommended (SSE-S3 or SSE-KMS).
#   - Cross-region replication or provider durability strategy for DR.
# RESTORE CONTRACT:
#   PostgreSQL backup protects metadata (TdrSourceFile, TdrBatch, TdrExportJob).
#   Object-storage backup protects binary files (source + export artifacts).
#   A valid restore requires BOTH: metadata DB and object storage in sync.
#   storageKey, contentHash, tenantId, sourceFileId must be preserved across restore.

# ── TLS / HTTPS ───────────────────────────────────────────────────────────────
# Production deployment contract:
#   - HTTPS is MANDATORY in production.
#   - TLS termination must occur at the reverse proxy / load balancer / ingress.
#   - This application serves HTTP; the proxy forwards to it over the internal network.
#   - Secure cookies depend on HTTPS being present at the client-facing layer.
#   - Do NOT trust arbitrary X-Forwarded-* headers unless your proxy is verified.
#
# Deployment example (nginx):
#   listen 443 ssl;
#   proxy_pass http://localhost:4000;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto https;

# ── Metrics protection ────────────────────────────────────────────────────────
# Bearer token protecting GET /metrics (Prometheus scrape target).
# Required in production — startup will reject unauthenticated scrape requests without it.
# Dev: unset = open endpoint (convenient for local dev tooling).
# Generate: openssl rand -hex 32
# Configure your Prometheus scrape job with: bearer_token: <value>
METRICS_TOKEN=""

# ── Webhook secret encryption ─────────────────────────────────────────────────
# AES-256-GCM key for webhook signing secrets at rest.
# REQUIRED in production — onModuleInit() throws FATAL if missing with NODE_ENV=production.
# CRITICAL OPERATIONAL SECRET: losing this key makes stored webhook signing secrets
# unrecoverable. Back up securely. Never commit. Control rotation carefully.
# Format: exactly 64 lowercase hex characters (32 bytes).
# Generate: openssl rand -hex 32
TDR_WEBHOOK_SECRET_ENCRYPTION_KEY=""

# ── Secret management contract ────────────────────────────────────────────────
# Secrets must be injected into the environment at deploy time via:
#   - CI/CD secret store (GitHub Actions secrets, GitLab CI variables, etc.)
#   - Cloud secret manager (AWS Secrets Manager, GCP Secret Manager, etc.)
#   - Container orchestrator secrets (Kubernetes secrets, Docker Swarm secrets)
# NEVER commit real secrets to this repository.
# The application validates secrets at startup and refuses to start if invalid.
